# ==============================================================================
# Git 忽略规则文件 (.gitignore)
# ==============================================================================

# 1. ImageBuilder 下载缓存与解压工作空间
.work/

# 2. 本地构建固件产物与分发归档目录
bin/

# 3. 压缩归档、临时镜像与日志文件
*.tar.zst
*.tar.gz
*.img
*.img.gz
*.log

# 4. Python 运行时缓存文件
__pycache__/
*.py[cod]
*$py.class

# 5. 编辑器配置文件与系统临时文件
.vscode/
.idea/
*.swp
*~
.DS_Store
