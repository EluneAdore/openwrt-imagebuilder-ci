+# 尚未创建的策略路由表属于正常状态，其他查询错误必须保留。
+policy_route_exists() {
+	local routes
+	if routes="$(ip route show table 999 2>&1)"; then
+		printf '%s\n' "$routes" | grep -Eq "^local.*dev lo"
+	else
+		case "$routes" in
+			*"FIB table does not exist"*) return 1 ;;
+			*) printf '%s\n' "$routes" >&2; return 2 ;;
+		esac
+	fi
+}
