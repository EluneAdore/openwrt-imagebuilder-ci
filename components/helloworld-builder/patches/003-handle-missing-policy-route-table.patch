-		ip route del local 0.0.0.0/0 dev lo table 999 2>/dev/null
+	if policy_route_exists; then
+		ip route del local 0.0.0.0/0 dev lo table 999 || return 1
+	elif [ "$?" -ne 1 ]; then
+		return 1
 	fi
 
